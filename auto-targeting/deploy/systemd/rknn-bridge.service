[Unit]
Description=Auto-Targeting RKNN Bridge (C++ NPU inference microservice)
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/opt/auto-targeting
ExecStart=/opt/auto-targeting/bin/rknn-bridge --socket /tmp/rknn-bridge.sock --model /opt/auto-targeting/models/yolov8n_int8.rknn
Restart=on-failure
RestartSec=2

User=autotarget
Group=autotarget

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/auto-targeting /tmp

LimitNOFILE=1024
MemoryMax=1G

[Install]
WantedBy=multi-user.target
