[Unit]
Description=Auto-Targeting Camera publisher (V4L2 -> SHM ring)
After=autotarget-bus.service
[Service]
Type=simple
User=orangepi
Group=orangepi
EnvironmentFile=/etc/auto-targeting/autotarget.env
WorkingDirectory=/home/orangepi/auto-targeting/auto-targeting
ExecStart=/bin/sh -c 'exec $HOME_DIR/target/release/examples/camera_publisher --name $SEGMENT --device $CAM_DEVICE --width $CAM_WIDTH --height $CAM_HEIGHT --fps $CAM_FPS --format $CAM_FORMAT --seconds 0 --bus $BUS'
Restart=always
RestartSec=2
RUST_LOG=info

[Install]
WantedBy=multi-user.target
